# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://seu-projeto.supabase.co

# Supabase > Project Settings > API Keys > chave "service_role" (ou "secret").
# Use a chave de servidor: ela ignora o RLS. Nunca exponha essa chave no front-end.
SUPABASE_KEY=sua-chave-service-role

# RabbitMQ do docker-compose.yml (usuário/senha admin/admin)
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# Porta da API Express
PORT=3000
